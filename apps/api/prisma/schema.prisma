// Groundline core data model.
//
// Identity lives in Supabase Auth (the `auth` schema, owned by the auth server).
// `users.id` is the Supabase user id; this table stores the application profile.
// Every organization-owned record carries an `organization_id` for tenant isolation.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id              String   @id @db.Uuid
  email           String   @unique
  fullName        String?  @map("full_name")
  avatarUrl       String?  @map("avatar_url")
  isPlatformAdmin Boolean  @default(false) @map("is_platform_admin")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships         OrganizationMember[]
  invitationsSent     Invitation[]         @relation("InvitedBy")
  invitationsAccepted Invitation[]         @relation("AcceptedBy")
  auditLogs           AuditLog[]
  knowledgeSources    KnowledgeSource[]
  ticketsAssigned     Ticket[]             @relation("TicketAssignee")
  ticketsCreated      Ticket[]             @relation("TicketCreator")
  ticketEvents        TicketEvent[]
  approvalsDecided    ApprovalRequest[]
  evalDatasets        EvalDataset[]
  evalRuns            EvalRun[]

  @@map("users")
}

model Organization {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String
  slug           String   @unique
  settings       Json     @default("{}")
  // The organization's customer record in Dodo Payments, created at first checkout.
  dodoCustomerId String?  @unique @map("dodo_customer_id")
  // Public key that identifies the organization to the embeddable chat widget.
  widgetKey      String?  @unique @map("widget_key")
  // Secret the organization's site signs visitor identity tokens with (encrypted at rest).
  identitySecret String?  @map("identity_secret")
  // Last ticket number issued; tickets are numbered per organization.
  ticketSeq      Int      @default(1000) @map("ticket_seq")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members       OrganizationMember[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  payments      Payment[]
  paymentEvents PaymentEvent[]
  usage         UsageCounter[]
  knowledge     KnowledgeSource[]
  conversations Conversation[]
  messages      Message[]
  customers     Customer[]
  tickets       Ticket[]
  ticketEvents  TicketEvent[]
  agentRuns     AgentRun[]
  toolCalls     ToolCall[]
  approvals     ApprovalRequest[]
  integrations  Integration[]
  evalDatasets  EvalDataset[]
  evalRuns      EvalRun[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           OrgRole
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String           @id @default(uuid(7)) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  role           OrgRole
  // SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  invitedById    String?          @map("invited_by_id") @db.Uuid
  acceptedById   String?          @map("accepted_by_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy   User?        @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
}

// Append-only record of administrative and agent actions (BR-013).
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  metadata       Json     @default("{}")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---- Billing -------------------------------------------------------------------
//
// Payments are processed by Dodo Payments. Our records are a projection of the provider's
// state, updated only from verified webhook events (or an explicit reconciliation fetch).

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  ON_HOLD
  PAUSED
  CANCELLED
  FAILED
  EXPIRED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

// Sellable plans. Limits and prices are data so they can change without a deploy.
model Plan {
  id            String   @id @default(uuid(7)) @db.Uuid
  key           String   @unique
  name          String
  description   String
  // Price per billing interval in the smallest currency unit (cents).
  priceCents    Int      @map("price_cents")
  currency      String   @default("USD")
  interval      String   @default("month")
  // The matching subscription product in Dodo Payments; null for free plans.
  dodoProductId String?  @unique @map("dodo_product_id")
  // { members, knowledgeSources, monthlyMessages }; -1 means unlimited.
  limits        Json
  features      String[]
  isPublic      Boolean  @default(true) @map("is_public")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions Subscription[]

  @@map("plans")
}

// The organization's current paid subscription. Organizations without one are on the free plan.
model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus
  dodoSubscriptionId String?            @unique @map("dodo_subscription_id")
  dodoCustomerId     String?            @map("dodo_customer_id")
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt        DateTime?          @map("cancelled_at") @db.Timestamptz(6)
  pastDueEndsAt      DateTime?          @map("past_due_ends_at") @db.Timestamptz(6)
  // Provider timestamp of the newest event applied, so late, out-of-order events are skipped.
  lastEventAt        DateTime?          @map("last_event_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@index([dodoCustomerId])
  @@map("subscriptions")
}

// Charges recorded from payment webhooks: the organization's transaction history.
model Payment {
  id                 String    @id @default(uuid(7)) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  dodoPaymentId      String    @unique @map("dodo_payment_id")
  dodoSubscriptionId String?   @map("dodo_subscription_id")
  amountCents        Int       @map("amount_cents")
  currency           String
  status             String
  chargeType         String?   @map("charge_type")
  invoiceUrl         String?   @map("invoice_url")
  providerCreatedAt  DateTime  @map("provider_created_at") @db.Timestamptz(6)
  lastEventAt        DateTime? @map("last_event_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, providerCreatedAt(sort: Desc)])
  @@map("payments")
}

// Every verified webhook delivery, keyed by its webhook-id for idempotency (BR-011).
model PaymentEvent {
  id                 String             @id @default(uuid(7)) @db.Uuid
  webhookId          String             @unique @map("webhook_id")
  type               String
  organizationId     String?            @map("organization_id") @db.Uuid
  dodoSubscriptionId String?            @map("dodo_subscription_id")
  dodoPaymentId      String?            @map("dodo_payment_id")
  occurredAt         DateTime           @map("occurred_at") @db.Timestamptz(6)
  payload            Json
  status             PaymentEventStatus @default(RECEIVED)
  error              String?
  attempts           Int                @default(1)
  processedAt        DateTime?          @map("processed_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([status])
  @@map("payment_events")
}

// Metered usage per organization and calendar month, checked against plan limits.
model UsageCounter {
  organizationId String   @map("organization_id") @db.Uuid
  metric         String
  periodStart    DateTime @map("period_start") @db.Date
  count          Int      @default(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, metric, periodStart])
  @@map("usage_counters")
}

// ---- Knowledge base -------------------------------------------------------------
//
// Sources are owned here. Their text chunks and embeddings live in the AI service's
// `ai.knowledge_chunks` table (pgvector), which references knowledge_sources with
// ON DELETE CASCADE so a deleted source can never be retrieved again (BR-014).

enum KnowledgeSourceType {
  FILE
  URL
  TEXT
}

enum KnowledgeSourceStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model KnowledgeSource {
  id             String                @id @default(uuid(7)) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  type           KnowledgeSourceType
  status         KnowledgeSourceStatus @default(PENDING)
  title          String
  // Object storage key of the original file (or the pasted text, stored as a file).
  fileKey        String?               @map("file_key")
  fileName       String?               @map("file_name")
  mimeType       String?               @map("mime_type")
  sizeBytes      Int?                  @map("size_bytes")
  url            String?
  chunkCount     Int                   @default(0) @map("chunk_count")
  characterCount Int?                  @map("character_count")
  error          String?
  // Processing bookkeeping for the ingestion worker (BR-012).
  attempts       Int                   @default(0)
  lockedAt       DateTime?             @map("locked_at") @db.Timestamptz(6)
  processedAt    DateTime?             @map("processed_at") @db.Timestamptz(6)
  createdById    String?               @map("created_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("knowledge_sources")
}

// ---- Conversations --------------------------------------------------------------

enum ConversationChannel {
  WIDGET
  PLAYGROUND
}

enum ConversationStatus {
  OPEN
  ESCALATED
  RESOLVED
}

enum MessageRole {
  CUSTOMER
  ASSISTANT
  AGENT
}

enum AnswerStatus {
  ANSWERED
  INSUFFICIENT_CONTEXT
  ERROR
}

model Conversation {
  id             String              @id @default(uuid(7)) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  channel        ConversationChannel
  status         ConversationStatus  @default(OPEN)
  // Anonymous identifier the widget keeps in the visitor's browser.
  visitorId      String              @map("visitor_id")
  visitorName    String?             @map("visitor_name")
  visitorEmail   String?             @map("visitor_email")
  // Set when the visitor's identity was verified with a token signed by the organization.
  customerId     String?             @map("customer_id") @db.Uuid
  title          String?
  // Set once the AI has answered at least once, for the monthly conversation limit.
  aiEngagedAt    DateTime?           @map("ai_engaged_at") @db.Timestamptz(6)
  escalatedAt    DateTime?           @map("escalated_at") @db.Timestamptz(6)
  resolvedAt     DateTime?           @map("resolved_at") @db.Timestamptz(6)
  lastMessageAt  DateTime            @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages     Message[]
  tickets      Ticket[]
  agentRuns    AgentRun[]
  toolCalls    ToolCall[]
  approvals    ApprovalRequest[]

  @@index([organizationId, lastMessageAt(sort: Desc)])
  @@index([organizationId, status])
  @@map("conversations")
}

model Message {
  id                String        @id @default(uuid(7)) @db.Uuid
  conversationId    String        @map("conversation_id") @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  role              MessageRole
  content           String
  // Assistant replies only.
  answerStatus      AnswerStatus? @map("answer_status")
  // [{ sourceId, title, snippet, score }] backing the answer (FR-035).
  sources           Json          @default("[]")
  provider          String?
  model             String?
  inputTokens       Int?          @map("input_tokens")
  outputTokens      Int?          @map("output_tokens")
  latencyMs         Int?          @map("latency_ms")
  // Background review of sampled answers against the sources they cite (hallucination
  // monitoring). Scores are 0–1.
  groundedness      Float?
  relevance         Float?
  unsupportedClaims Json?         @map("unsupported_claims")
  reviewNotes       String?       @map("review_notes")
  reviewJudge       String?       @map("review_judge")
  reviewTokens      Int?          @map("review_tokens")
  reviewedAt        DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, reviewedAt])
  @@map("messages")
}

// ---- Customers ----------------------------------------------------------------------

// End customers of an organization, known from verified widget identity tokens.
model Customer {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  // The customer's id in the organization's own system (the token's `sub`).
  externalId     String   @map("external_id")
  email          String?
  name           String?
  attributes     Json     @default("{}")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  tickets       Ticket[]

  @@unique([organizationId, externalId])
  @@map("customers")
}

// ---- Tickets ------------------------------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketSource {
  AI
  CUSTOMER
  AGENT
}

model Ticket {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  // Human-friendly number, unique within the organization.
  number         Int
  subject        String
  description    String?
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  source         TicketSource
  conversationId String?        @map("conversation_id") @db.Uuid
  customerId     String?        @map("customer_id") @db.Uuid
  assigneeId     String?        @map("assignee_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  resolvedAt     DateTime?      @map("resolved_at") @db.Timestamptz(6)
  closedAt       DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee     User?             @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events       TicketEvent[]
  approvals    ApprovalRequest[]

  @@unique([organizationId, number])
  @@index([organizationId, status, updatedAt(sort: Desc)])
  @@index([assigneeId, status])
  @@index([conversationId])
  @@map("tickets")
}

enum TicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  ASSIGNED
  NOTE
}

// Ticket activity history, including internal notes (never shown to customers).
model TicketEvent {
  id             String          @id @default(uuid(7)) @db.Uuid
  ticketId       String          @map("ticket_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  type           TicketEventType
  // NOTE: { body }. STATUS_CHANGED, PRIORITY_CHANGED, ASSIGNED: { from, to }.
  data           Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket       Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

// ---- Agent tools and approvals ------------------------------------------------------

enum AgentRunStatus {
  COMPLETED
  FAILED
}

// One AI reply, which may take several model steps and tool calls.
model AgentRun {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  messageId      String?        @unique @map("message_id") @db.Uuid
  status         AgentRunStatus
  steps          Int
  provider       String?
  model          String?
  inputTokens    Int            @default(0) @map("input_tokens")
  outputTokens   Int            @default(0) @map("output_tokens")
  latencyMs      Int            @map("latency_ms")
  // Version of the answering prompt that produced the reply.
  promptVersion  String?        @map("prompt_version")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolCalls    ToolCall[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("agent_runs")
}

enum ToolCallStatus {
  SUCCEEDED
  FAILED
  // Refused before running: unknown or disabled tool, invalid input, no verified customer.
  BLOCKED
  PENDING_APPROVAL
  REJECTED
}

// Every tool the agent asked to run, with input, outcome and timing (FR-053).
model ToolCall {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  agentRunId     String?        @map("agent_run_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  tool           String
  input          Json
  output         Json?
  status         ToolCallStatus
  sensitive      Boolean        @default(false)
  error          String?
  durationMs     Int?           @map("duration_ms")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentRun     AgentRun?        @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  conversation Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  approval     ApprovalRequest?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt])
  @@map("tool_calls")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// A sensitive action waiting for a person to approve it (FR-054, BR-007).
model ApprovalRequest {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  toolCallId     String         @unique @map("tool_call_id") @db.Uuid
  conversationId String?        @map("conversation_id") @db.Uuid
  ticketId       String?        @map("ticket_id") @db.Uuid
  status         ApprovalStatus @default(PENDING)
  // What will happen if approved, in plain words.
  summary        String
  decidedById    String?        @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?      @map("decided_at") @db.Timestamptz(6)
  decisionNote   String?        @map("decision_note")
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toolCall     ToolCall      @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  ticket       Ticket?       @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  decidedBy    User?         @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@map("approval_requests")
}

// ---- Integrations -------------------------------------------------------------------

enum IntegrationKind {
  // Built-in demo store with realistic fake customers, orders and subscriptions.
  SANDBOX
  // The organization's own backend, called with signed HTTP requests.
  ACTIONS_API
}

model Integration {
  id             String          @id @default(uuid(7)) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  kind           IntegrationKind
  enabled        Boolean         @default(true)
  // ACTIONS_API: { baseUrl }.
  config         Json            @default("{}")
  // Request signing secret (encrypted at rest).
  secret         String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind])
  @@map("integrations")
}

// ---- Evaluations ------------------------------------------------------------------------

// A named set of test questions for checking the assistant's answers (FR-063).
model EvalDataset {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  cases        EvalCase[]
  runs         EvalRun[]

  @@unique([organizationId, name])
  @@map("eval_datasets")
}

model EvalCase {
  id                 String   @id @default(uuid(7)) @db.Uuid
  datasetId          String   @map("dataset_id") @db.Uuid
  question           String
  // What a good answer says. Optional; without it only relevance and groundedness are scored.
  expectedAnswer     String?  @map("expected_answer")
  // Knowledge sources a good answer should be based on, for retrieval quality.
  expectedSourceIds  String[] @default([]) @map("expected_source_ids") @db.Uuid
  // The assistant should decline (out of scope, unsafe, or not in the knowledge base).
  expectInsufficient Boolean  @default(false) @map("expect_insufficient")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dataset EvalDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results EvalResult[]

  @@index([datasetId, createdAt])
  @@map("eval_cases")
}

enum EvalRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// One run of a dataset against the assistant as configured at the time (FR-067).
model EvalRun {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  datasetId      String        @map("dataset_id") @db.Uuid
  status         EvalRunStatus @default(QUEUED)
  totalCases     Int           @map("total_cases")
  completedCases Int           @default(0) @map("completed_cases")
  passedCases    Int           @default(0) @map("passed_cases")
  // Aggregate scores; see EvalMetrics in @groundline/shared.
  metrics        Json          @default("{}")
  promptVersion  String?       @map("prompt_version")
  provider       String?
  model          String?
  judge          String?
  inputTokens    Int           @default(0) @map("input_tokens")
  outputTokens   Int           @default(0) @map("output_tokens")
  error          String?
  createdById    String?       @map("created_by_id") @db.Uuid
  startedAt      DateTime?     @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataset      EvalDataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  results      EvalResult[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([datasetId, createdAt(sort: Desc)])
  @@map("eval_runs")
}

// A case's outcome in a run. The question and expectations are copied so history stays
// readable after cases are edited or deleted.
model EvalResult {
  id                 String   @id @default(uuid(7)) @db.Uuid
  runId              String   @map("run_id") @db.Uuid
  caseId             String?  @map("case_id") @db.Uuid
  question           String
  expectedAnswer     String?  @map("expected_answer")
  expectInsufficient Boolean  @default(false) @map("expect_insufficient")
  answer             String
  answerStatus       String   @map("answer_status")
  passed             Boolean
  relevance          Float?
  groundedness       Float?
  correctness        Float?
  retrievalHit       Boolean? @map("retrieval_hit")
  reciprocalRank     Float?   @map("reciprocal_rank")
  retrievedSourceIds String[] @default([]) @map("retrieved_source_ids")
  unsupportedClaims  Json     @default("[]") @map("unsupported_claims")
  judgeNotes         String?  @map("judge_notes")
  latencyMs          Int      @map("latency_ms")
  inputTokens        Int      @default(0) @map("input_tokens")
  outputTokens       Int      @default(0) @map("output_tokens")
  error              String?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run      EvalRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  evalCase EvalCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@unique([runId, caseId])
  @@index([runId, createdAt])
  @@map("eval_results")
}
