# Groundline local development environment.
# Copy to `.env` (`cp .env.example .env`) and fill in the secrets.
# Docker Compose and the API both read this file.

# ---- URLs ----------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# ---- Postgres (docker compose service "db") -----------------------------------
DB_PORT=54322
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/groundline

# ---- Redis ---------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Supabase Auth -------------------------------------------------------------
# Local dev runs the Supabase Auth server (GoTrue) in docker on AUTH_PORT.
# For a hosted Supabase project, set SUPABASE_AUTH_URL=https://<ref>.supabase.co/auth/v1,
# SUPABASE_ANON_KEY to the project's anon/publishable key, and either SUPABASE_JWT_SECRET
# (legacy HS256) or leave it empty to verify tokens against the project's JWKS.
AUTH_PORT=9999
AUTH_DB_PASSWORD=change-me-auth-db-password
SUPABASE_AUTH_URL=http://localhost:9999
SUPABASE_ANON_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SUPABASE_JWT_SECRET=

# ---- Email (Mailpit in development: http://localhost:8025) ----------------------
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Groundline <no-reply@groundline.local>"

# ---- Billing (Dodo Payments) ---------------------------------------------------
# Leave empty to run without billing. Use test mode keys from
# https://app.dodopayments.com > Developer > API Keys / Webhooks.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# Subscription product ids for the paid plans (Products in the Dodo dashboard),
# applied to the plan catalog by `pnpm db:seed`.
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=

# ---- Object storage (RustFS locally, AWS S3 in production) ------------------------
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=groundline-uploads
S3_ACCESS_KEY=groundline
S3_SECRET_KEY=groundline-dev-secret

# ---- AI service -------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
# Shared secret the API uses to call the AI service. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_SERVICE_TOKEN=
# OpenAI answers questions and embeds documents; DeepSeek answers if OpenAI is unavailable.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6.1-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
# Signs the tokens that let a chat widget visitor read their own conversation.
WIDGET_TOKEN_SECRET=
