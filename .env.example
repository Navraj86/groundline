# Groundline local development environment.
# Copy to `.env` (`cp .env.example .env`) and fill in the secrets.
# Docker Compose and the API both read this file.

# ---- URLs ----------------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000

# ---- Postgres (docker compose service "db") -----------------------------------
DB_PORT=54322
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/groundline

# ---- Redis ---------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- Supabase Auth -------------------------------------------------------------
# Local dev runs the Supabase Auth server (GoTrue) in docker on AUTH_PORT.
# For a hosted Supabase project, set SUPABASE_AUTH_URL=https://<ref>.supabase.co/auth/v1,
# SUPABASE_ANON_KEY to the project's anon/publishable key, and either SUPABASE_JWT_SECRET
# (legacy HS256) or leave it empty to verify tokens against the project's JWKS.
AUTH_PORT=9999
AUTH_DB_PASSWORD=change-me-auth-db-password
SUPABASE_AUTH_URL=http://localhost:9999
SUPABASE_ANON_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SUPABASE_JWT_SECRET=

# ---- Email (Mailpit in development: http://localhost:8025) ----------------------
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_URL=smtp://dev:dev@localhost:1025
MAIL_FROM="Groundline <no-reply@groundline.local>"
