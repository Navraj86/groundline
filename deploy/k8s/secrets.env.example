# Copy to secrets.env (git-ignored) and create the Secret:
#   kubectl -n groundline create secret generic groundline --from-env-file=secrets.env
DATABASE_URL=postgresql://user:password@postgres.example.com:5432/groundline?sslmode=verify-full
# Optional: a separate URL for Prisma migrations if TLS options differ (see docs/deploy-aws.md).
MIGRATE_DATABASE_URL=
REDIS_URL=rediss://redis.example.com:6379
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SMTP_URL=smtps://user:password@email-smtp.us-east-1.amazonaws.com:465
AI_SERVICE_TOKEN=
WIDGET_TOKEN_SECRET=
ENCRYPTION_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
