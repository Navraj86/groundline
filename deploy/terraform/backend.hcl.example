# Copy to backend.hcl and run: terraform init -backend-config=backend.hcl
# The bucket must exist first (docs/deploy-aws.md, step 3). State contains the generated
# database password and keys, so keep the bucket private, encrypted and versioned.
bucket       = "groundline-terraform-state-123456789012"
key          = "prod/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true
