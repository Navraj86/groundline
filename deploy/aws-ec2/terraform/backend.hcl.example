# Copy to backend.hcl and run: terraform init -backend-config=backend.hcl
# The bucket must exist first (docs/deploy-aws-terraform.md, step 3). State contains generated
# keys, so keep the bucket private, encrypted and versioned.
bucket       = "groundline-terraform-state-123456789012"
key          = "ec2-prod/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true
