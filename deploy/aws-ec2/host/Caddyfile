# Public HTTPS for the API, with certificates from Let's Encrypt renewed automatically.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	encode zstd gzip

	# Knowledge uploads are up to 20 MB.
	request_body {
		max_size 25MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}

	reverse_proxy api:4000 {
		health_uri /health
		health_interval 15s
	}
}
